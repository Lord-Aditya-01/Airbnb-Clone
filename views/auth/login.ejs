<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen">
    <%- include('../partials/nav') %>
    <%- include('../partials/flash') %>

    <main class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-md w-full bg-white rounded-3xl shadow-xl border border-gray-200 overflow-hidden">
        
        <!-- Header -->
        <div class="border-b border-gray-200 py-5 px-6 text-center relative">
          <h2 class="text-base font-bold text-gray-900">Log in or sign up</h2>
        </div>

        <div class="p-8">
          <h1 class="text-2xl font-bold text-gray-900 mb-6">Welcome to Airbnb</h1>

          <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="mb-5 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-sm flex items-center gap-2">
              <i class="fas fa-exclamation-circle text-rose-500"></i>
              <span><%= errorMessage %></span>
            </div>
          <% } %>

          <form action="/login" method="POST" class="space-y-4">
            <div>
              <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">Email address</label>
              <input 
                id="email" 
                name="email" 
                type="email" 
                autocomplete="email" 
                required 
                value="<%= typeof oldInput !== 'undefined' ? oldInput.email : '' %>"
                placeholder="name@example.com" 
                class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-900 text-sm focus:ring-2 focus:ring-black focus:border-transparent outline-none transition"
              />
            </div>

            <div>
              <div class="flex justify-between items-center mb-1">
                <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-gray-700">Password</label>
              </div>
              <input 
                id="password" 
                name="password" 
                type="password" 
                autocomplete="current-password" 
                required 
                placeholder="Enter your password" 
                class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-900 text-sm focus:ring-2 focus:ring-black focus:border-transparent outline-none transition"
              />
            </div>

            <button 
              type="submit" 
              class="w-full bg-[#FF385C] hover:bg-[#E00B41] text-white font-semibold py-3.5 px-4 rounded-xl shadow-md transition duration-200 text-sm tracking-wide mt-2">
              Continue
            </button>
          </form>

          <!-- Quick Demo Login Buttons for convenience -->
          <div class="mt-6 pt-6 border-t border-gray-200">
            <p class="text-xs text-gray-500 font-medium text-center uppercase tracking-wider mb-3">Quick demo test accounts</p>
            <div class="grid grid-cols-2 gap-2">
              <button 
                type="button" 
                onclick="document.getElementById('email').value='host@airbnb.com'; document.getElementById('password').value='password123'; this.form ? this.form.submit() : document.querySelector('form').submit();"
                class="w-full py-2 px-3 border border-gray-300 hover:border-black rounded-xl text-xs font-semibold text-gray-800 bg-gray-50 hover:bg-gray-100 transition text-center">
                <i class="fas fa-crown text-amber-500 mr-1"></i> Demo Host
              </button>
              <button 
                type="button" 
                onclick="document.getElementById('email').value='guest@airbnb.com'; document.getElementById('password').value='password123'; this.form ? this.form.submit() : document.querySelector('form').submit();"
                class="w-full py-2 px-3 border border-gray-300 hover:border-black rounded-xl text-xs font-semibold text-gray-800 bg-gray-50 hover:bg-gray-100 transition text-center">
                <i class="fas fa-user text-blue-500 mr-1"></i> Demo Guest
              </button>
            </div>
            <p class="text-[11px] text-gray-400 text-center mt-2">Password for demo accounts: <span class="font-mono text-gray-600">password123</span></p>
          </div>

          <div class="mt-6 text-center text-sm text-gray-600">
            Don't have an account? 
            <a href="/signup" class="font-semibold text-gray-900 hover:underline">Sign up</a>
          </div>

        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>
