<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen">
    <%- include('../partials/nav') %>
    <%- include('../partials/flash') %>

    <main class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-md w-full bg-white rounded-3xl shadow-xl border border-gray-200 overflow-hidden">
        
        <!-- Header -->
        <div class="border-b border-gray-200 py-5 px-6 text-center">
          <h2 class="text-base font-bold text-gray-900">Sign up on Airbnb</h2>
        </div>

        <div class="p-8">
          <h1 class="text-2xl font-bold text-gray-900 mb-2">Create your account</h1>
          <p class="text-sm text-gray-500 mb-6">Discover amazing places to stay or share your space.</p>

          <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="mb-5 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-sm flex items-center gap-2">
              <i class="fas fa-exclamation-circle text-rose-500"></i>
              <span><%= errorMessage %></span>
            </div>
          <% } %>

          <form action="/signup" method="POST" class="space-y-4">
            
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="firstName" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">First name</label>
                <input 
                  id="firstName" 
                  name="firstName" 
                  type="text" 
                  required 
                  value="<%= typeof oldInput !== 'undefined' ? oldInput.firstName : '' %>"
                  placeholder="John" 
                  class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-900 text-sm focus:ring-2 focus:ring-black focus:border-transparent outline-none transition"
                />
              </div>
              <div>
                <label for="lastName" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">Last name</label>
                <input 
                  id="lastName" 
                  name="lastName" 
                  type="text" 
                  required 
                  value="<%= typeof oldInput !== 'undefined' ? oldInput.lastName : '' %>"
                  placeholder="Doe" 
                  class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-900 text-sm focus:ring-2 focus:ring-black focus:border-transparent outline-none transition"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">Email address</label>
              <input 
                id="email" 
                name="email" 
                type="email" 
                required 
                value="<%= typeof oldInput !== 'undefined' ? oldInput.email : '' %>"
                placeholder="name@example.com" 
                class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-900 text-sm focus:ring-2 focus:ring-black focus:border-transparent outline-none transition"
              />
            </div>

            <div>
              <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">Password</label>
              <input 
                id="password" 
                name="password" 
                type="password" 
                required 
                minlength="6"
                placeholder="At least 6 characters" 
                class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-900 text-sm focus:ring-2 focus:ring-black focus:border-transparent outline-none transition"
              />
            </div>

            <div>
              <label for="confirmPassword" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">Confirm password</label>
              <input 
                id="confirmPassword" 
                name="confirmPassword" 
                type="password" 
                required 
                minlength="6"
                placeholder="Re-enter password" 
                class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-900 text-sm focus:ring-2 focus:ring-black focus:border-transparent outline-none transition"
              />
            </div>

            <!-- Role Selection -->
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">I want to:</label>
              <div class="grid grid-cols-2 gap-3">
                <label class="border border-gray-300 rounded-xl p-3 flex items-center space-x-2 cursor-pointer hover:border-black transition has-[:checked]:border-black has-[:checked]:bg-gray-50">
                  <input type="radio" name="userType" value="guest" checked class="text-black focus:ring-black">
                  <span class="text-xs font-semibold text-gray-800">Book stays (Guest)</span>
                </label>
                <label class="border border-gray-300 rounded-xl p-3 flex items-center space-x-2 cursor-pointer hover:border-black transition has-[:checked]:border-black has-[:checked]:bg-gray-50">
                  <input type="radio" name="userType" value="host" class="text-black focus:ring-black">
                  <span class="text-xs font-semibold text-gray-800">Host places (Host)</span>
                </label>
              </div>
            </div>

            <p class="text-xs text-gray-500 pt-1">
              By selecting Agree and continue, I agree to Airbnb's Terms of Service, Payments Terms of Service, and Nondiscrimination Policy.
            </p>

            <button 
              type="submit" 
              class="w-full bg-[#FF385C] hover:bg-[#E00B41] text-white font-semibold py-3.5 px-4 rounded-xl shadow-md transition duration-200 text-sm tracking-wide mt-2">
              Agree and continue
            </button>
          </form>

          <div class="mt-6 text-center text-sm text-gray-600">
            Already have an account? 
            <a href="/login" class="font-semibold text-gray-900 hover:underline">Log in</a>
          </div>

        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>
