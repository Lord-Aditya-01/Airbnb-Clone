<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen">
    <%- include('../partials/nav') %>
    <%- include('../partials/flash') %>

    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
      <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Trips & Reservations</h1>
        <p class="text-sm text-gray-500 mt-1">Review your upcoming vacations, check-in details, and past reservations.</p>
      </div>

      <% if (typeof bookings !== 'undefined' && bookings.length > 0) { %>
        <div class="space-y-6">
          <% bookings.forEach(booking => { %>
            <div class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition duration-200 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
              
              <!-- Left: Image & Listing Details -->
              <div class="flex items-start sm:items-center gap-5 w-full md:w-auto">
                <img 
                  src="<%= booking.homePhoto || 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=800' %>" 
                  alt="<%= booking.homeName %>" 
                  class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl object-cover flex-shrink-0"
                />
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-xs uppercase font-bold tracking-wider px-2 py-0.5 rounded-full <%= booking.status === 'Cancelled' ? 'bg-gray-100 text-gray-600' : 'bg-emerald-100 text-emerald-800' %>">
                      <%= booking.status %>
                    </span>
                    <span class="text-xs text-gray-400">ID: <%= booking.id %></span>
                  </div>
                  <h3 class="text-lg font-bold text-gray-900 leading-snug"><%= booking.homeName %></h3>
                  <p class="text-xs text-gray-500 mt-0.5"><i class="fas fa-location-dot mr-1"></i> <%= booking.location %></p>
                  
                  <div class="flex flex-wrap items-center gap-3 mt-2 text-xs text-gray-700">
                    <span class="bg-gray-100 px-2.5 py-1 rounded-lg font-medium">
                      <i class="far fa-calendar mr-1"></i> <%= booking.checkIn %> to <%= booking.checkOut %> (<%= booking.nights %> <%= booking.nights === 1 ? 'night' : 'nights' %>)
                    </span>
                    <span class="bg-gray-100 px-2.5 py-1 rounded-lg font-medium">
                      <i class="fas fa-user-group mr-1"></i> <%= booking.guests %> <%= booking.guests === 1 ? 'guest' : 'guests' %>
                    </span>
                  </div>
                </div>
              </div>

              <!-- Right: Price & Cancel Action -->
              <div class="flex md:flex-col items-center md:items-end justify-between w-full md:w-auto gap-4 pt-4 md:pt-0 border-t md:border-t-0 border-gray-100">
                <div class="text-left md:text-right">
                  <span class="text-xs text-gray-500 block">Total reservation</span>
                  <span class="text-xl font-bold text-gray-900">₹<%= Number(booking.totalPrice).toLocaleString('en-IN') %></span>
                </div>

                <div class="flex items-center gap-3">
                  <a href="/homes/<%= booking.homeId %>" class="text-xs font-semibold text-gray-800 hover:text-black border border-gray-300 hover:border-black px-3.5 py-2 rounded-xl transition">
                    View Stay
                  </a>

                  <% if (booking.status !== 'Cancelled') { %>
                    <form action="/bookings/cancel/<%= booking.id %>" method="POST" onsubmit="return confirm('Are you sure you want to cancel this reservation?');">
                      <button type="submit" class="text-xs font-semibold text-rose-600 hover:text-white hover:bg-rose-600 border border-rose-200 hover:border-rose-600 px-3.5 py-2 rounded-xl transition">
                        Cancel Trip
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>

            </div>
          <% }) %>
        </div>

      <% } else { %>
        <!-- Empty State -->
        <div class="bg-white rounded-3xl border border-gray-200 p-12 text-center max-w-lg mx-auto shadow-sm my-8">
          <div class="w-20 h-20 bg-rose-50 text-[#FF385C] rounded-full flex items-center justify-center mx-auto mb-5 text-3xl">
            <i class="fas fa-suitcase-rolling"></i>
          </div>
          <h2 class="text-2xl font-bold text-gray-900 mb-2">No trips booked... yet!</h2>
          <p class="text-sm text-gray-500 mb-8 max-w-sm mx-auto">
            Time to dust off your bags and start planning your next great adventure. Discover beach villas, mountain cabins, and city lofts.
          </p>
          <a href="/" class="inline-block bg-[#FF385C] hover:bg-[#E00B41] text-white font-semibold py-3.5 px-8 rounded-xl shadow-md transition duration-200 text-sm">
            Start Exploring Stays
          </a>
        </div>
      <% } %>

    </main>

    <%- include('../partials/footer') %>
  </body>
</html>