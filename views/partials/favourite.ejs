<% 
  const isFav = (typeof userFavIds !== 'undefined' && userFavIds && userFavIds.includes(home.id)) || (typeof isFavourite !== 'undefined' && isFavourite);
%>
<form action="/favourites" method="POST" class="inline" onclick="event.stopPropagation();">
  <input type="hidden" name="id" value="<%= home.id %>" />
  <button 
    type="submit" 
    class="p-2 rounded-full hover:scale-110 active:scale-95 transition-transform duration-150 focus:outline-none"
    title="<%= isFav ? 'Remove from wishlist' : 'Save to wishlist' %>">
    <svg 
      xmlns="http://www.w3.org/2000/svg" 
      viewBox="0 0 32 32" 
      aria-hidden="true" 
      role="presentation" 
      focusable="false" 
      class="w-6 h-6 stroke-white stroke-[2.5px] transition-colors duration-150 <%= isFav ? 'fill-[#FF385C] stroke-[#FF385C]' : 'fill-black/40 hover:fill-black/60' %>">
      <path d="M16 28c7-4.73 14-10 14-17a6.98 6.98 0 0 0-7-7c-1.8 0-3.58.68-4.95 2.05L16 8.1l-2.05-2.05A6.98 6.98 0 0 0 9 4a6.98 6.98 0 0 0-7 7c0 7 7 12.27 14 17z"></path>
    </svg>
  </button>
</form>
