<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen">
    <%- include('../partials/nav') %>
    <%- include('../partials/flash') %>

    <main class="flex-grow max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
      
      <div class="mb-8">
        <a href="/host/host-home-list" class="inline-flex items-center text-xs font-semibold text-gray-500 hover:text-black mb-3 transition">
          <i class="fas fa-arrow-left mr-2"></i> Back to Host Dashboard
        </a>
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">
          <%= editing ? "Edit Your Listing" : "Register Your Home on Airbnb" %>
        </h1>
        <p class="text-sm text-gray-500 mt-1">
          <%= editing ? "Update your property details, pricing, and amenities." : "Tell travelers about your space and start welcoming guests." %>
        </p>
      </div>

      <div class="bg-white rounded-3xl border border-gray-200 shadow-sm p-6 sm:p-10">
        <form action="/host/<%= editing ? "edit-home" : "add-home" %>" method="POST" class="space-y-8">
          
          <% if (editing && home) { %>
            <input type="hidden" name="id" value="<%= home.id %>" />
          <% } %>

          <!-- Section 1: Basic Details -->
          <div>
            <h2 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
              <i class="fas fa-heading text-rose-500 text-sm"></i> Listing Basics
            </h2>
            <div class="space-y-4">
              <div>
                <label for="houseName" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Listing Title</label>
                <input
                  type="text"
                  id="houseName"
                  name="houseName"
                  required
                  value="<%= editing && home ? home.houseName : '' %>"
                  placeholder="e.g. Modern Cliffside Villa with Ocean Views"
                  class="w-full px-4 py-3 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-black outline-none transition"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="category" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Category</label>
                  <select 
                    id="category" 
                    name="category" 
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-black outline-none transition cursor-pointer">
                    <% const cats = ['Beachfront', 'Cabins', 'Mansions', 'Lakefront', 'Iconic cities', 'Countryside', 'Trending', 'Tiny homes']; %>
                    <% cats.forEach(c => { %>
                      <option value="<%= c %>" <%= editing && home && home.category === c ? 'selected' : '' %>><%= c %></option>
                    <% }) %>
                  </select>
                </div>

                <div>
                  <label for="price" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Price Per Night (₹)</label>
                  <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-gray-500 text-sm font-semibold">₹</span>
                    <input
                      type="number"
                      id="price"
                      name="price"
                      required
                      min="100"
                      value="<%= editing && home ? home.price : '2500' %>"
                      placeholder="2500"
                      class="w-full pl-8 pr-4 py-3 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-black outline-none transition"
                    />
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="location" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Location</label>
                  <input
                    type="text"
                    id="location"
                    name="location"
                    required
                    value="<%= editing && home ? home.location : '' %>"
                    placeholder="e.g. Goa, India or Jaipur, Rajasthan"
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-black outline-none transition"
                  />
                </div>
                <div>
                  <label for="rating" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Starting Rating</label>
                  <input
                    type="number"
                    step="0.01"
                    min="1"
                    max="5"
                    id="rating"
                    name="rating"
                    value="<%= editing && home ? home.rating : '4.90' %>"
                    placeholder="4.90"
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-black outline-none transition"
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- Section 2: Space & Capacity -->
          <div>
            <h2 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
              <i class="fas fa-users text-rose-500 text-sm"></i> Capacity & Rooms
            </h2>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              <div>
                <label for="maxGuests" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Max Guests</label>
                <input 
                  type="number" 
                  id="maxGuests" 
                  name="maxGuests" 
                  min="1" 
                  value="<%= editing && home && home.maxGuests ? home.maxGuests : 4 %>" 
                  class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm outline-none"
                />
              </div>
              <div>
                <label for="bedrooms" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Bedrooms</label>
                <input 
                  type="number" 
                  id="bedrooms" 
                  name="bedrooms" 
                  min="1" 
                  value="<%= editing && home && home.bedrooms ? home.bedrooms : 2 %>" 
                  class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm outline-none"
                />
              </div>
              <div>
                <label for="beds" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Beds</label>
                <input 
                  type="number" 
                  id="beds" 
                  name="beds" 
                  min="1" 
                  value="<%= editing && home && home.beds ? home.beds : 2 %>" 
                  class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm outline-none"
                />
              </div>
              <div>
                <label for="bathrooms" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Bathrooms</label>
                <input 
                  type="number" 
                  id="bathrooms" 
                  name="bathrooms" 
                  min="1" 
                  value="<%= editing && home && home.bathrooms ? home.bathrooms : 2 %>" 
                  class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm outline-none"
                />
              </div>
            </div>
          </div>

          <!-- Section 3: Photos -->
          <div>
            <h2 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
              <i class="fas fa-camera text-rose-500 text-sm"></i> Photos
            </h2>
            <div class="space-y-4">
              <div>
                <label for="photoUrl" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Main Cover Photo URL</label>
                <input
                  type="url"
                  id="photoUrl"
                  name="photoUrl"
                  required
                  value="<%= editing && home ? home.photoUrl : '' %>"
                  placeholder="https://images.unsplash.com/photo-..."
                  class="w-full px-4 py-3 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-black outline-none transition"
                  oninput="document.getElementById('preview-img').src = this.value;"
                />
              </div>

              <!-- Live Photo Preview -->
              <div>
                <p class="text-xs text-gray-500 mb-1 font-medium">Cover Photo Preview:</p>
                <div class="w-full h-44 rounded-2xl overflow-hidden bg-gray-100 border border-gray-200">
                  <img 
                    id="preview-img" 
                    src="<%= editing && home && home.photoUrl ? home.photoUrl : 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=800' %>" 
                    alt="Cover preview" 
                    class="w-full h-full object-cover"
                    onerror="this.src='https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=800'"
                  />
                </div>
              </div>

              <div>
                <label for="additionalPhotos" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Additional Photos (Comma separated URLs)</label>
                <input
                  type="text"
                  id="additionalPhotos"
                  name="additionalPhotos"
                  value="<%= editing && home && home.additionalPhotos ? home.additionalPhotos.join(', ') : '' %>"
                  placeholder="https://images.unsplash.com/photo-1, https://images.unsplash.com/photo-2"
                  class="w-full px-4 py-3 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-black outline-none transition"
                />
              </div>
            </div>
          </div>

          <!-- Section 4: Amenities -->
          <div>
            <h2 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
              <i class="fas fa-sparkles text-rose-500 text-sm"></i> Amenities
            </h2>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              <% 
                const availableAmenities = [
                  'Wifi', 'Kitchen', 'Free parking', 'Air conditioning', 
                  'Pool', 'Hot tub', 'Beach access', 'Dedicated workspace', 
                  'Mountain view', 'Indoor fireplace', 'Sauna', 'Garden view'
                ];
                const activeAmenities = editing && home && home.amenities ? home.amenities : ['Wifi', 'Kitchen', 'Free parking'];
              %>
              <% availableAmenities.forEach(amenity => { %>
                <label class="border border-gray-200 rounded-xl p-3 flex items-center space-x-2.5 cursor-pointer hover:border-black transition has-[:checked]:border-black has-[:checked]:bg-gray-50">
                  <input 
                    type="checkbox" 
                    name="amenities" 
                    value="<%= amenity %>" 
                    <%= activeAmenities.includes(amenity) ? 'checked' : '' %>
                    class="rounded text-black focus:ring-black"
                  />
                  <span class="text-xs font-semibold text-gray-800"><%= amenity %></span>
                </label>
              <% }) %>
            </div>
          </div>

          <!-- Section 5: Description -->
          <div>
            <h2 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
              <i class="fas fa-align-left text-rose-500 text-sm"></i> Description
            </h2>
            <textarea
              name="description"
              rows="5"
              placeholder="Describe what makes your space special, nearby attractions, unique views, and house rules..."
              class="w-full px-4 py-3 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-black outline-none transition"
            ><%= editing && home ? home.description : '' %></textarea>
          </div>

          <!-- Submit Button -->
          <div class="pt-4 border-t border-gray-200 flex items-center justify-end gap-4">
            <a href="/host/host-home-list" class="px-6 py-3 rounded-xl border border-gray-300 text-sm font-semibold text-gray-700 hover:bg-gray-100 transition">
              Cancel
            </a>
            <button 
              type="submit" 
              class="bg-[#FF385C] hover:bg-[#E00B41] text-white font-semibold py-3 px-8 rounded-xl shadow-md transition duration-200 text-sm">
              <%= editing ? "Save Changes" : "Publish Listing" %>
            </button>
          </div>

        </form>
      </div>

    </main>

    <%- include('../partials/footer') %>
  </body>
</html>