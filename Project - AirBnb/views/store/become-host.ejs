<%- include('../partials/head') %>
  </head>
  <body class="bg-white flex flex-col min-h-screen">
    <%- include('../partials/nav') %>
    <%- include('../partials/flash') %>

    <main class="flex-grow">
      
      <!-- Hero Section -->
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <span class="text-[#FF385C] font-bold text-sm tracking-widest uppercase">Airbnb it easily with Airbnb Setup</span>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 tracking-tight mt-4 mb-6 leading-tight">
              Airbnb your home.<br/>
              <span class="text-[#FF385C]">You could earn</span> ₹45,000 / month
            </h1>
            <p class="text-lg text-gray-600 mb-8 max-w-lg">
              Join thousands of hosts welcoming guests worldwide. Share your unique space, earn extra income, and meet travelers from across the globe with full AirCover protection.
            </p>

            <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
              <% if (typeof isHost !== 'undefined' && isHost) { %>
                <div class="flex items-center gap-4">
                  <a href="/host/add-home" class="bg-[#FF385C] hover:bg-[#E00B41] text-white font-semibold py-4 px-8 rounded-xl shadow-lg transition duration-200">
                    + Create New Listing
                  </a>
                  <a href="/host/host-home-list" class="border border-gray-300 hover:border-black font-semibold py-4 px-8 rounded-xl transition duration-200 text-gray-800">
                    Manage My Listings
                  </a>
                </div>
              <% } else { %>
                <form action="/become-host" method="POST">
                  <button type="submit" class="bg-[#FF385C] hover:bg-[#E00B41] text-white font-semibold py-4 px-8 rounded-xl shadow-lg transition duration-200 text-lg">
                    <i class="fas fa-home mr-2"></i> Activate Host Account & Get Started
                  </button>
                </form>
              <% } %>
            <% } else { %>
              <div class="flex flex-wrap items-center gap-4">
                <a href="/signup" class="bg-[#FF385C] hover:bg-[#E00B41] text-white font-semibold py-4 px-8 rounded-xl shadow-lg transition duration-200 text-lg">
                  Sign Up as a Host
                </a>
                <a href="/login" class="border border-gray-300 hover:border-black font-semibold py-4 px-8 rounded-xl transition duration-200 text-gray-800 text-lg">
                  Log in
                </a>
              </div>
            <% } %>
          </div>

          <div class="relative">
            <div class="rounded-3xl overflow-hidden shadow-2xl">
              <img 
                src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=1000&auto=format&fit=crop&q=80" 
                alt="Modern villa" 
                class="w-full h-[450px] object-cover"
              />
            </div>
            <div class="absolute -bottom-6 -left-6 bg-white p-6 rounded-2xl shadow-xl border border-gray-100 hidden sm:block max-w-xs">
              <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold">
                  <i class="fas fa-shield-alt"></i>
                </div>
                <div>
                  <h4 class="font-bold text-gray-900 text-sm">Top-to-bottom protection</h4>
                  <p class="text-xs text-gray-500">Only with AirCover for Hosts</p>
                </div>
              </div>
              <p class="text-xs text-gray-600">Up to $3M damage protection and $1M liability coverage.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 3 Steps Section -->
      <section class="bg-gray-50 py-16 border-t border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-3xl font-bold text-gray-900 text-center mb-12">Airbnb-ing it is easy with 3 simple steps</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="bg-white p-8 rounded-2xl border border-gray-200 shadow-sm">
              <div class="w-12 h-12 bg-rose-100 text-[#FF385C] rounded-xl flex items-center justify-center text-xl font-bold mb-6">
                1
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-3">Tell us about your place</h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                Share some basic info like location, how many guests can stay, and what kind of space it is.
              </p>
            </div>

            <div class="bg-white p-8 rounded-2xl border border-gray-200 shadow-sm">
              <div class="w-12 h-12 bg-rose-100 text-[#FF385C] rounded-xl flex items-center justify-center text-xl font-bold mb-6">
                2
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-3">Make it stand out</h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                Add 5 or more high-resolution photos along with title, description, and list of modern amenities.
              </p>
            </div>

            <div class="bg-white p-8 rounded-2xl border border-gray-200 shadow-sm">
              <div class="w-12 h-12 bg-rose-100 text-[#FF385C] rounded-xl flex items-center justify-center text-xl font-bold mb-6">
                3
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-3">Finish and publish</h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                Choose your starting price per night, publish your listing, and start receiving guest bookings right away.
              </p>
            </div>
          </div>
        </div>
      </section>

    </main>

    <%- include('../partials/footer') %>
  </body>
</html>
