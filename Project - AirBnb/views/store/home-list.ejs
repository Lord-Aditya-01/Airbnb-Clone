<%- include('../partials/head') %>
  </head>
  <body class="bg-white flex flex-col min-h-screen">
    <%- include('../partials/nav') %>
    <%- include('../partials/categories') %>
    <%- include('../partials/flash') %>

    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
      <div class="mb-6 flex justify-between items-center">
        <div>
          <h1 class="text-2xl font-bold text-gray-900">Explore All Stays</h1>
          <p class="text-sm text-gray-500 mt-1">Discover verified Airbnb homes around the world</p>
        </div>
        <span class="text-sm font-semibold text-gray-700 bg-gray-100 px-3 py-1.5 rounded-full">
          <%= registeredHomes.length %> stays available
        </span>
      </div>

      <% if (typeof registeredHomes !== 'undefined' && registeredHomes.length > 0) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-10">
          <% registeredHomes.forEach(home => { %>
            <div class="group relative flex flex-col cursor-pointer">
              
              <div class="relative aspect-square w-full overflow-hidden rounded-2xl bg-gray-100 mb-3 shadow-sm group-hover:shadow-md transition duration-200">
                <a href="/homes/<%= home.id %>" class="block w-full h-full">
                  <img 
                    src="<%= home.photoUrl || 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=800' %>" 
                    alt="<%= home.houseName %>" 
                    class="h-full w-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </a>

                <% if (parseFloat(home.rating) >= 4.9) { %>
                  <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-md px-2.5 py-1 rounded-full shadow text-[11px] font-bold tracking-tight text-gray-900 uppercase">
                    Guest favourite
                  </div>
                <% } %>

                <div class="absolute top-2 right-2 z-10">
                  <%- include('../partials/favourite', { home: home }) %>
                </div>
              </div>

              <a href="/homes/<%= home.id %>" class="flex flex-col flex-grow">
                <div class="flex justify-between items-start text-sm font-semibold text-gray-900 leading-snug">
                  <span class="truncate pr-2"><%= home.location || home.houseName %></span>
                  <div class="flex items-center flex-shrink-0 text-gray-900">
                    <i class="fas fa-star text-[11px] mr-1 text-black"></i>
                    <span><%= home.rating || '4.90' %></span>
                  </div>
                </div>

                <p class="text-xs text-gray-500 truncate mt-0.5"><%= home.houseName %></p>
                <p class="text-xs text-gray-500 mt-0.5"><%= home.category || 'Vacation Stay' %> · Available now</p>

                <div class="mt-2 text-sm text-gray-900">
                  <span class="font-bold">₹<%= Number(home.price || 0).toLocaleString('en-IN') %></span>
                  <span class="font-normal text-gray-600"> night</span>
                </div>
              </a>

            </div>
          <% }) %>
        </div>

      <% } else { %>
        <div class="py-24 text-center max-w-md mx-auto">
          <div class="w-16 h-16 bg-rose-50 text-[#FF385C] rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
            <i class="fas fa-search-location"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">No homes available</h3>
          <p class="text-gray-500 text-sm mb-6">No homes match your current selection.</p>
          <a href="/homes" class="inline-block bg-[#FF385C] hover:bg-[#E00B41] text-white font-semibold py-3 px-6 rounded-xl transition shadow">
            View All Homes
          </a>
        </div>
      <% } %>

    </main>

    <%- include('../partials/footer') %>
  </body>
</html>
