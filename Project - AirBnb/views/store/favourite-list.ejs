<%- include('../partials/head') %>
  </head>
  <body class="bg-white flex flex-col min-h-screen">
    <%- include('../partials/nav') %>
    <%- include('../partials/flash') %>

    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
      <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Your Wishlists</h1>
        <p class="text-sm text-gray-500 mt-1">Saved stays and dream vacation rentals.</p>
      </div>

      <% if (typeof favouriteHomes !== 'undefined' && favouriteHomes.length > 0) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-10">
          <% favouriteHomes.forEach(home => { %>
            <div class="group relative flex flex-col cursor-pointer">
              
              <div class="relative aspect-square w-full overflow-hidden rounded-2xl bg-gray-100 mb-3 shadow-sm group-hover:shadow-md transition duration-200">
                <a href="/homes/<%= home.id %>" class="block w-full h-full">
                  <img 
                    src="<%= home.photoUrl || 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=800' %>" 
                    alt="<%= home.houseName %>" 
                    class="h-full w-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </a>

                <!-- Remove heart button -->
                <div class="absolute top-2 right-2 z-10">
                  <form action="/favourites/delete/<%= home.id %>" method="POST" onclick="event.stopPropagation();">
                    <button type="submit" class="p-2 rounded-full hover:scale-110 active:scale-95 transition-transform duration-150 focus:outline-none" title="Remove from wishlist">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="w-6 h-6 fill-[#FF385C] stroke-[#FF385C] stroke-[2px]">
                        <path d="M16 28c7-4.73 14-10 14-17a6.98 6.98 0 0 0-7-7c-1.8 0-3.58.68-4.95 2.05L16 8.1l-2.05-2.05A6.98 6.98 0 0 0 9 4a6.98 6.98 0 0 0-7 7c0 7 7 12.27 14 17z"></path>
                      </svg>
                    </button>
                  </form>
                </div>
              </div>

              <a href="/homes/<%= home.id %>" class="flex flex-col flex-grow">
                <div class="flex justify-between items-start text-sm font-semibold text-gray-900 leading-snug">
                  <span class="truncate pr-2"><%= home.location || home.houseName %></span>
                  <div class="flex items-center flex-shrink-0 text-gray-900">
                    <i class="fas fa-star text-[11px] mr-1 text-black"></i>
                    <span><%= home.rating || '4.90' %></span>
                  </div>
                </div>

                <p class="text-xs text-gray-500 truncate mt-0.5"><%= home.houseName %></p>
                <p class="text-xs text-gray-500 mt-0.5"><%= home.category || 'Vacation Stay' %></p>

                <div class="mt-2 text-sm text-gray-900">
                  <span class="font-bold">₹<%= Number(home.price || 0).toLocaleString('en-IN') %></span>
                  <span class="font-normal text-gray-600"> night</span>
                </div>
              </a>

            </div>
          <% }) %>
        </div>

      <% } else { %>
        <!-- Empty State -->
        <div class="bg-gray-50 rounded-3xl border border-gray-200 p-12 text-center max-w-lg mx-auto shadow-sm my-8">
          <div class="w-20 h-20 bg-rose-50 text-[#FF385C] rounded-full flex items-center justify-center mx-auto mb-5 text-3xl">
            <i class="fas fa-heart"></i>
          </div>
          <h2 class="text-2xl font-bold text-gray-900 mb-2">Create your first wishlist</h2>
          <p class="text-sm text-gray-500 mb-8 max-w-sm mx-auto">
            As you search, tap the heart icon on any stay to save your favourite places here.
          </p>
          <a href="/" class="inline-block bg-[#FF385C] hover:bg-[#E00B41] text-white font-semibold py-3.5 px-8 rounded-xl shadow-md transition duration-200 text-sm">
            Start Exploring
          </a>
        </div>
      <% } %>

    </main>

    <%- include('../partials/footer') %>
  </body>
</html>
