<div class="border-b border-gray-200 bg-white sticky top-20 z-40 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center space-x-8 overflow-x-auto no-scrollbar py-4">
      <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
        <% categories.forEach(cat => { %>
          <% const isActive = (typeof selectedCategory !== 'undefined' && selectedCategory.toLowerCase() === cat.name.toLowerCase()); %>
          <a 
            href="/?category=<%= encodeURIComponent(cat.name) %><%= typeof searchQuery !== 'undefined' && searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>"
            class="flex flex-col items-center flex-shrink-0 group pb-2 relative transition duration-150 <%= isActive ? 'text-black border-b-2 border-black font-semibold' : 'text-gray-500 hover:text-black border-b-2 border-transparent' %>">
            <i class="fas <%= cat.icon %> text-xl mb-2 transition-transform duration-200 group-hover:scale-110 <%= isActive ? 'text-black' : 'text-gray-500 group-hover:text-black' %>"></i>
            <span class="text-xs whitespace-nowrap"><%= cat.name %></span>
          </a>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>
