<% if (typeof successMessage !== 'undefined' && successMessage) { %>
  <div id="flash-success-banner" class="max-w-6xl mx-auto px-4 sm:px-6 pt-4">
    <div class="flex items-center justify-between p-4 mb-2 text-sm text-emerald-800 rounded-2xl bg-emerald-50 border border-emerald-200 shadow-sm" role="alert">
      <div class="flex items-center">
        <i class="fas fa-check-circle text-emerald-600 mr-3 text-lg"></i>
        <span class="font-medium"><%= successMessage %></span>
      </div>
      <button onclick="document.getElementById('flash-success-banner').remove()" class="text-emerald-500 hover:text-emerald-800 p-1 rounded-lg">
        <i class="fas fa-times"></i>
      </button>
    </div>
  </div>
<% } %>

<% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
  <div id="flash-error-banner" class="max-w-6xl mx-auto px-4 sm:px-6 pt-4">
    <div class="flex items-center justify-between p-4 mb-2 text-sm text-rose-800 rounded-2xl bg-rose-50 border border-rose-200 shadow-sm" role="alert">
      <div class="flex items-center">
        <i class="fas fa-exclamation-circle text-rose-600 mr-3 text-lg"></i>
        <span class="font-medium"><%= errorMessage %></span>
      </div>
      <button onclick="document.getElementById('flash-error-banner').remove()" class="text-rose-500 hover:text-rose-800 p-1 rounded-lg">
        <i class="fas fa-times"></i>
      </button>
    </div>
  </div>
<% } %>
